# Environment configuration for Story Weaver.
# Gemini AI calls use Firebase AI Logic + App Check (no client API key required).
# OPENROUTER_API_KEY: API key for OpenRouter text & image generation models (configure in AI Studio Secrets panel).
OPENROUTER_API_KEY=OPENROUTER_API_KEY_DEFAULT_VALUE
# UNOROUTER_API_KEY: API key for Unorouter OpenAI-compatible AI Chat & Parser (configure in AI Studio Secrets panel).
UNOROUTER_API_KEY=UNOROUTER_API_KEY_DEFAULT_VALUE
